# Nginx Configuration for MediFlow
# Generated by Ansible - {{ ansible_date_time.iso8601 }}
# Environment: {{ environment }}

user {{ app_user }};
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections | default(1024) }};
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout {{ nginx_keepalive_timeout | default(65) }};
    types_hash_max_size {{ nginx_types_hash_max_size | default(2048) }};
    client_max_body_size {{ nginx_client_max_body_size | default('20M') }};

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level {{ nginx_gzip_level | default(6) }};
    gzip_types text/plain text/css text/xml text/javascript 
               application/json application/javascript application/xml+rss;

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=general:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

    # Upstream Gunicorn
    upstream gunicorn_app {
        least_conn;
        server unix:{{ app_home }}/gunicorn.sock fail_timeout=0;
    }

    # HTTP redirect to HTTPS
    server {
        listen 80;
        listen [::]:80;
        server_name {{ server_names | join(' ') }};
        
        location /.well-known/acme-challenge/ {
            root {{ app_home }};
        }
        
        location / {
            return 301 https://$server_name$request_uri;
        }
    }

    # HTTPS configuration
    server {
        listen 443 ssl http2;
        listen [::]:443 ssl http2;
        server_name {{ server_names | join(' ') }};

        # SSL Certificate
        ssl_certificate {{ ssl_cert_path | default('/etc/ssl/certs/mediflow.crt') }};
        ssl_certificate_key {{ ssl_key_path | default('/etc/ssl/private/mediflow.key') }};
        
        # SSL Configuration
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        # Security headers
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "no-referrer-when-downgrade" always;

        client_max_body_size 20M;

        location /static/ {
            root {{ app_home }};
            expires 30d;
        }

        location /media/ {
            root {{ app_home }};
            expires 7d;
        }

        location / {
            limit_req zone=general burst=20 nodelay;
            
            proxy_pass http://gunicorn_app;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
            proxy_connect_timeout {{ nginx_proxy_connect_timeout | default(60) }}s;
            proxy_send_timeout {{ nginx_proxy_send_timeout | default(60) }}s;
            proxy_read_timeout {{ nginx_proxy_read_timeout | default(60) }}s;
        }
    }
}
