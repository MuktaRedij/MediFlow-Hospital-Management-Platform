# Gunicorn Configuration File
# Generated by Ansible - {{ ansible_date_time.iso8601 }}
# Environment: {{ environment }}

import multiprocessing

# Server socket
bind = 'unix:{{ app_home }}/gunicorn.sock'
backlog = 2048

# Worker processes
workers = {{ gunicorn_workers | default(multiprocessing.cpu_count() * 2 + 1) }}
worker_class = '{{ gunicorn_worker_class | default('sync') }}'
worker_connections = {{ gunicorn_worker_connections | default(1000) }}
timeout = {{ gunicorn_timeout | default(30) }}
keepalive = {{ gunicorn_keepalive | default(2) }}

# Server mechanics
daemon = False
pidfile = '{{ app_home }}/gunicorn.pid'
umask = 0o022
user = '{{ app_user }}'
group = '{{ app_group }}'
tmp_upload_dir = None

# Logging
accesslog = '{{ log_dir }}/gunicorn_access.log'
access_log_format = '%(h)s %(l)s %(u)s %(t)s "%(r)s" %(s)s %(b)s "%(f)s" "%(a)s" %(D)s'
errorlog = '{{ log_dir }}/gunicorn_error.log'
loglevel = '{{ gunicorn_log_level | default('info') }}'
access_log_format = '[%(asctime)s] %(levelname)s %(message)s'

# Process naming
proc_name = '{{ app_name }}'

# Server hooks
def on_starting(server):
    print(f'Gunicorn {server.cfg.proc_name} starting')

def when_ready(server):
    print(f'Gunicorn {server.cfg.proc_name} ready')

def on_exit(server):
    print(f'Gunicorn {server.cfg.proc_name} stopping')

# SSL (if enabled)
{% if enable_ssl %}
keyfile = '{{ ssl_key_path }}'
certfile = '{{ ssl_cert_path }}'
ssl_version = 'TLSv1_2'
cert_reqs = 2
ca_certs = '{{ ssl_ca_path | default('') }}'
{% endif %}

# Application settings
raw_env = [
    'DJANGO_SETTINGS_MODULE=config.settings.{{ environment }}',
]

# Server mechanics
reload = {{ gunicorn_reload | default('False') }}
reload_extra_files = [
    '{{ app_home }}/config/settings.py',
]

# Performance
max_requests = {{ gunicorn_max_requests | default(1000) }}
max_requests_jitter = {{ gunicorn_max_requests_jitter | default(50) }}

# Graceful timeout
graceful_timeout = {{ gunicorn_graceful_timeout | default(30) }}

# Preload app
preload_app = True

def post_fork(server, worker):
    server.log.info(f'Worker spawned (pid: {worker.pid})')

def post_worker_init(worker):
    worker.log.info('Worker init')

def worker_abort(worker):
    worker.log.info('Worker received SIGABRT or timeout')
