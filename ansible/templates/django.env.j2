# Django Environment Configuration
# Generated by Ansible {{ ansible_date_time.iso8601 }}
# Host: {{ inventory_hostname }}

# Debug and Core Settings
DEBUG={{ debug | default(false) }}
DJANGO_SETTINGS_MODULE={{ django_settings }}
ALLOWED_HOSTS={{ environment_variables.ALLOWED_HOSTS | default('localhost,127.0.0.1') }}
SECRET_KEY={{ secret_key }}

# Database Configuration
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}

# Email Service Configuration
EMAIL_BACKEND={{ environment_variables.EMAIL_BACKEND | default('django.core.mail.backends.smtp.EmailBackend') }}
EMAIL_HOST={{ email_service_url | default('email.example.com') }}
EMAIL_FROM_ADDRESS={{ email_from_address | default('noreply@mediflow.local') }}
EMAIL_PORT={{ email_port | default(587) }}

# Google Calendar Integration
GOOGLE_CALENDAR_ENABLED={{ google_calendar_enabled | default(true) }}
GOOGLE_CALENDAR_API_URL={{ google_calendar_api_url | default('https://www.googleapis.com/calendar/v3') }}

# Logging Configuration
LOG_LEVEL={{ log_level | default('INFO') }}
LOG_DIR={{ log_dir | default('/var/log/mediflow') }}

# Security Settings
SECURE_SSL_REDIRECT={{ enable_ssl | default(true) }}
SESSION_COOKIE_SECURE={{ enable_ssl | default(true) }}
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_SECURE={{ enable_ssl | default(true) }}

# Application Port
APP_PORT={{ app_port | default(8000) }}
APP_NAME={{ app_name }}
APP_USER={{ app_user }}

# Monitoring
ENABLE_MONITORING={{ enable_monitoring | default(true) }}
MONITORING_PORT={{ monitoring_port | default(9100) }}

# Backup Configuration
BACKUP_ENABLED={{ backup_enabled | default(true) }}
BACKUP_SCHEDULE={{ backup_schedule | default('daily') }}
